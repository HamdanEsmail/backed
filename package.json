{
  "name": "backed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backed: one line about a startup in, a ranked list of the investors who backed companies like it out, each match proved by the sentence quoted from its funding announcement. Built on the TinyFish APIs.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run && wrangler deploy --dry-run",
    "migrate:local": "wrangler d1 migrations apply backed --local",
    "migrate:remote": "wrangler d1 migrations apply backed --remote"
  },
  "dependencies": {
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.156.2"
  }
}
